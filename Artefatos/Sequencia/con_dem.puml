@startuml
actor Usuario
boundary Frontend as FE
control DemandaController as C
control DemandaService as S
entity DemandaModel as M
database "Banco de Dados" as DB

Usuario -> FE : consultarDemandas(filtros)
activate FE
FE -> C : GET /demandas
activate C
C -> S : consultarDemandas(filtros)
activate S
S -> M : queryComFiltros(filtros)
activate M
M -> DB : SELECT demandas
activate DB
DB --> M : registros
deactivate DB
M --> S : listaDemandas
deactivate M
S --> C : listaDemandas
deactivate S
C --> FE : respostaOK
deactivate C
FE --> Usuario : apresentarDemandas
deactivate FE
@enduml
