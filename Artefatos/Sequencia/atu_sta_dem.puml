@startuml
actor Usuario

boundary Frontend as FE
control DemandaController as C
control DemandService as S
control DemandAlertService as Alert
entity Demanda as M
control AuthorizationService as AuthZ
control ValidationService as Val
control HistoryService as Hist
queue "Fila / Queue" as Queue
participant "ProcessDemandAlertJob" as Job
participant "ChatbotNotificationClient" as Client
participant "Chatbot API" as Chatbot
participant "Servidor WebSocket" as WS

Usuario -> FE : alterarStatusDemanda(status)
FE -> C : PUT /demandas/{id}/status

C -> AuthZ : verificarPermissao("DEMANDS_UPDATE")
AuthZ --> C : permitido

C -> Val : validarStatusDemanda(status)
Val --> C : ok

C -> S : atualizarStatusDemanda(idDemanda, status, usuarioAutenticado)
S -> M : find(idDemanda)
M --> S : demandaEncontradaOuNull

alt demanda inexistente
    S --> C : erro("Demanda nao encontrada")
    C --> FE : respostaErro
    FE --> Usuario : exibirErro
else demanda encontrada
    S -> M : update({status = status})
    M --> S : demandaAtualizada
    S -> Hist : registrar("Status atualizado", usuarioAutenticado, demandaAtualizada)
    Hist --> S : ok
    S -> Alert : createDemandUpdatedAlerts(demandaAtualizada, changes)
    Alert -> Queue : dispatch ProcessDemandAlertJob

    par alerta interno
      Queue -> Job : processar alerta system
      Job -> Client : publishSystemAlert(...)
      Client -> Chatbot : POST /internal/notifications/websocket-alert
      Chatbot -> WS : publicar popup
      WS --> FE : atualizar alertas
    else alerta ao cidadao
      Queue -> Job : processar alerta chatbot
      Job -> Client : sendCitizenMessage(...)
      Client -> Chatbot : POST /internal/notifications/chatbot-message
    end

    S --> C : sucesso(demandaAtualizada)
    C --> FE : respostaOK
    FE --> Usuario : exibirSucesso
end
@enduml
