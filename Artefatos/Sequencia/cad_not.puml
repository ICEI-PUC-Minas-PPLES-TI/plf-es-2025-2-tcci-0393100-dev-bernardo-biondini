@startuml
actor Usuario

boundary Frontend as FE
control NoticiaController as C
control NoticiaService as S
entity NoticiaModel as M
control AuthorizationService as AuthZ
control ValidationService as Val
control FileStorageService as FS
database "Banco de Dados" as DB

Usuario -> FE : preencherFormNoticia()
activate FE
FE -> C : POST /noticias
activate C
C -> AuthZ : verificarPermissao("CADASTRAR_NOTICIA")
activate AuthZ
AuthZ --> C : permitido
deactivate AuthZ
C -> Val : validarCamposNoticia(dados)
activate Val
Val --> C : ok
deactivate Val

alt imagem informada
  C -> Val : validarImagem(image)
  activate Val
  Val --> C : imagemValida
  deactivate Val
end

C -> S : cadastrarNoticia(dados, usuario)
activate S
alt imagem informada
  S -> FS : armazenar(image)
  activate FS
  FS --> S : imagePath
  deactivate FS
end
S -> M : create(dados)
activate M
M -> DB : INSERT noticia
activate DB
DB --> M : noticiaPersistida
deactivate DB
M --> S : noticiaCriada
deactivate M
S --> C : sucesso(noticiaCriada)
deactivate S
C --> FE : respostaOK
deactivate C
FE --> Usuario : exibirSucesso
deactivate FE
@enduml
