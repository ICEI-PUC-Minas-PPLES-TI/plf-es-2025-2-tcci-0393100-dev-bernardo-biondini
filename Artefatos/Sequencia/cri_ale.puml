@startuml
actor Usuario

boundary Frontend as FE
control AgendaReminderController as C
control AgendaReminderService as S
entity Evento as E
entity EventAlert as A
control AuthorizationService as AuthZ
control ValidationService as Val
queue "Fila / Queue" as Queue
participant "ProcessAgendaReminderJob" as Job
participant "ChatbotNotificationClient" as Client
participant "Chatbot API" as Chatbot
participant "Servidor WebSocket" as WS

Usuario -> FE : configurarLembrete(idEvento, dataHora, canal)
FE -> C : POST /agenda/reminders

C -> AuthZ : verificarPermissao("AGENDA_VIEW")
AuthZ --> C : permitido

C -> Val : validarDadosAlerta(dadosAlerta)
Val --> C : ok

C -> S : createUserAlert(dadosAlerta, usuarioAutenticado)
S -> E : find(idEvento)
E --> S : eventoOuNull

alt evento inexistente
    S --> C : erro("Evento nao encontrado")
    C --> FE : respostaErro
    FE --> Usuario : exibirErro
else evento encontrado
    S -> A : create(dados)
    A --> S : alertaCriado
    S --> C : sucesso(alertaCriado)
    C --> FE : respostaOK
    FE --> Usuario : alerta configurado

    ... quando alert_at for atingido ...

    S -> Queue : dispatchDueReminders()
    Queue -> Job : processar lembrete
    Job -> Client : publishSystemAlert(...)
    Client -> Chatbot : POST /internal/notifications/websocket-alert
    Chatbot -> WS : publicar lembrete
    WS --> FE : popup + lista de lembretes
end
@enduml
