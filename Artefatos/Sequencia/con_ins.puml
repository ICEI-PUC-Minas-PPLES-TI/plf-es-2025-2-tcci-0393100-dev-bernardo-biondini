@startuml
actor Usuario
boundary Frontend as FE
control InstituicaoController as C
control InstituicaoService as S
entity InstituicaoModel as M
control AuthorizationService as AuthZ
database "Banco de Dados" as DB

Usuario -> FE : solicitarListaInstituicoes(filtros)
activate FE
FE -> C : GET /instituicoes
activate C
C -> AuthZ : validarPermissao("CONSULTAR_INSTITUICOES")
activate AuthZ
AuthZ --> C : permitido
deactivate AuthZ
C -> S : consultarInstituicoes(filtros)
activate S
S -> M : query(filtros)
activate M
M -> DB : SELECT instituicoes
activate DB
DB --> M : registros
deactivate DB
M --> S : listaInstituicoes
deactivate M
S --> C : listaInstituicoes
deactivate S
C --> FE : respostaOK
deactivate C
FE --> Usuario : exibirLista
deactivate FE
@enduml
