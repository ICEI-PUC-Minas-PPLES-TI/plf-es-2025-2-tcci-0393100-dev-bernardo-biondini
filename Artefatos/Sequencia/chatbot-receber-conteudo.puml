@startuml
participant "Sistema de Conteudo" as CMSService
database "Banco de Dados" as DB
participant "Chatbot API" as Chatbot
participant "WhatsApp Business API" as WA
actor Cidadao

CMSService -> DB : consultar cidadaos com\nreceive_content = true
DB --> CMSService : lista de destinatarios
CMSService -> Chatbot : enviarConteudo(destinatarios, noticiaProjeto)
loop para cada destinatario
  Chatbot -> WA : enviar mensagem
  WA -> Cidadao : receber noticia/projeto
end
@enduml
