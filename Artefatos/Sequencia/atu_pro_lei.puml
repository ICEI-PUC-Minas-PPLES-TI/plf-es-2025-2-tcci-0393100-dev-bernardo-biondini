@startuml
actor Usuario

boundary Frontend as FE
control ProjetoLeiController as C
control ProjetoLeiService as S
entity ProjetoLeiModel as M
control AuthorizationService as AuthZ
control ValidationService as Val
control HistoryService as Hist
database "Banco de Dados" as DB

Usuario -> FE : atualizarProjetoLei(dados)
activate FE
FE -> C : PUT /projetos-lei/{id}
activate C
C -> AuthZ : verificarPermissao("PROJECT_LAWS_UPDATE")
activate AuthZ
AuthZ --> C : permitido
deactivate AuthZ
C -> Val : validarAtualizacaoProjetoLei(dados)
activate Val
Val --> C : ok
deactivate Val
C -> S : atualizarProjetoLei(id, dados, usuario)
activate S
S -> M : find(id)
activate M
M -> DB : SELECT projeto_lei
activate DB
DB --> M : registro
deactivate DB
M --> S : projetoOuNull
deactivate M

alt projeto inexistente
  S --> C : erro("Projeto de lei nao encontrado")
else projeto encontrado
  S -> M : update(dados)
  activate M
  M -> DB : UPDATE projeto_lei
  activate DB
  DB --> M : projetoPersistido
  deactivate DB
  M --> S : projetoAtualizado
  deactivate M
  S -> Hist : registrar("Projeto de lei atualizado")
  activate Hist
  Hist --> S : ok
  deactivate Hist
  S --> C : sucesso(projetoAtualizado)
end
deactivate S
C --> FE : resposta
deactivate C
FE --> Usuario : exibirResultado
deactivate FE
@enduml
