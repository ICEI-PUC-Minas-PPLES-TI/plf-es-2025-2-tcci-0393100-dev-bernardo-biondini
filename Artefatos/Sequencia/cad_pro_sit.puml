@startuml
actor Usuario

boundary Frontend as FE
control ProjetoSiteController as C
control ProjetoSiteService as S
entity ProjetoSiteModel as M
control AuthorizationService as AuthZ
control ValidationService as Val
control FileStorageService as FS
database "Banco de Dados" as DB

Usuario -> FE : preencherFormProjetoSite()
activate FE
FE -> C : POST /projetos-site
activate C
C -> AuthZ : verificarPermissao("CADASTRAR_PROJETO_SITE")
activate AuthZ
AuthZ --> C : permitido
deactivate AuthZ
C -> Val : validarDadosProjetoSite(dados)
activate Val
Val --> C : ok
deactivate Val

alt capa informada
  C -> Val : validarImagem(cover_image)
  activate Val
  Val --> C : imagemValida
  deactivate Val
end

C -> S : cadastrarProjetoSite(dados, usuario)
activate S
alt capa informada
  S -> FS : armazenar(cover_image)
  activate FS
  FS --> S : coverPath
  deactivate FS
end
S -> M : create(dados)
activate M
M -> DB : INSERT projeto_site
activate DB
DB --> M : projetoPersistido
deactivate DB
M --> S : projetoCriado
deactivate M
S --> C : sucesso(projetoCriado)
deactivate S
C --> FE : respostaOK
deactivate C
FE --> Usuario : exibirSucesso
deactivate FE
@enduml
