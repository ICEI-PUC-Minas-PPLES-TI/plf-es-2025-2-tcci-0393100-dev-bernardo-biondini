@startuml
actor Usuario

boundary Frontend as FE
control AgendaController as C
control AgendaService as S
entity EventoModel as M
control AuthorizationService as AuthZ
control ValidationService as Val
control HistoryService as Hist
database "Banco de Dados" as DB

Usuario -> FE : preencherFormEvento()
activate FE
FE -> C : POST /agenda/eventos
activate C
C -> AuthZ : verificarPermissao("CADASTRAR_EVENTO")
activate AuthZ
AuthZ --> C : permitido
deactivate AuthZ
C -> Val : validarDadosEvento(dados)
activate Val
Val --> C : ok
deactivate Val
C -> S : cadastrarEvento(dados, usuario)
activate S
S -> M : create(dados)
activate M
M -> DB : INSERT evento
activate DB
DB --> M : eventoPersistido
deactivate DB
M --> S : eventoCriado
deactivate M
S -> Hist : registrar("Cadastro de evento")
activate Hist
Hist --> S : ok
deactivate Hist
S --> C : sucesso(eventoCriado)
deactivate S
C --> FE : respostaOK
deactivate C
FE --> Usuario : exibirSucesso
deactivate FE
@enduml
