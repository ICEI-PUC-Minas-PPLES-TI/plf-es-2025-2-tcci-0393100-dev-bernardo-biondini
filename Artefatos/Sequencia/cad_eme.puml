@startuml
actor Usuario

boundary Frontend as FE
control EmendaController as C
control EmendaService as S
entity CidadeModel as City
entity EmendaModel as M
control AuthorizationService as AuthZ
control ValidationService as Val
control HistoryService as Hist
database "Banco de Dados" as DB

Usuario -> FE : preencherFormEmenda()
activate FE
FE -> C : POST /emendas
activate C
C -> AuthZ : verificarPermissao("CADASTRAR_EMENDA")
activate AuthZ
AuthZ --> C : permitido
deactivate AuthZ
C -> Val : validarDadosEmenda(dados)
activate Val
Val --> C : ok
deactivate Val
C -> S : cadastrarEmenda(dados, usuario)
activate S
S -> City : find(cidade_id)
activate City
City -> DB : SELECT cidade
activate DB
DB --> City : registro
deactivate DB
City --> S : cidadeOuNull
deactivate City

alt cidade inexistente
  S --> C : erro("Cidade nao encontrada")
else cidade valida
  S -> M : create(dados)
  activate M
  M -> DB : INSERT emenda
  activate DB
  DB --> M : emendaPersistida
  deactivate DB
  M --> S : emendaCriada
  deactivate M
  S -> Hist : registrar("Cadastro de Emenda")
  activate Hist
  Hist --> S : ok
  deactivate Hist
  S --> C : sucesso(emendaCriada)
end
deactivate S
C --> FE : resposta
deactivate C
FE --> Usuario : exibirResultado
deactivate FE
@enduml
