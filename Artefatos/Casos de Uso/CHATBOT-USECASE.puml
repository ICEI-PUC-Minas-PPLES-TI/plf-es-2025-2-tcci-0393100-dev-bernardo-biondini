@startuml
left to right direction
skinparam packageStyle rectangle

actor "Cidadão" as C

rectangle "Chatbot do Gabinete Virtual" {

  usecase "Cadastrar-se\n(nome, telefone)" as UC1

  usecase "Enviar Demanda" as UC2

  usecase "Receber Atualizações\nsobre Demandas" as UC3

  usecase "Optar por Receber Conteúdos" as UC4
}

C --> UC1
C --> UC2
C --> UC3
C --> UC4

UC2 --> UC1 : <<include>>
UC3 --> UC1 : <<include>>
UC4 --> UC1 : <<include>>

@enduml
