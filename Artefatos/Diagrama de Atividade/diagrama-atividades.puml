@startuml
title Diagrama de Atividades - Demandas, Alertas e Chatbot

skinparam shadowing false
skinparam activity {
  BackgroundColor #ffffff
  BorderColor #2c3e50
}

start

if (Origem da demanda?) then (painel interno)
  :Login no sistema;
  if (Credenciais validas?) then (sim)
    :Abrir modal de demanda;
    :Preencher titulo, descricao,\ncidade, instituicao opcional,\nprioridade e oficio;
    :Submeter demanda;
  else (nao)
    :Exibir erro de autenticacao;
    stop
  endif
else (chatbot)
  :Receber mensagem via WhatsApp;
  :Identificar cidadao pelo telefone;
  if (Cidadao existe?) then (sim)
    :Reaproveitar cadastro;
  else (nao)
    :Cadastrar nome e preferencia\nde receber atualizacoes;
  endif
  :Validar idioma, conteudo ofensivo\ne similaridade;
  if (Mensagem invalida?) then (sim)
    :Criar demanda descartada\ncom motivo registrado;
    :Enviar resposta ao cidadao\ncom protocolo e justificativa;
    stop
  else (nao)
    :Criar demanda via backend;
    :Enviar confirmacao ao cidadao;
  endif
endif

:Registrar historico da demanda;
:Associar responsavel quando aplicavel;

fork
  :Atualizar demanda\n(status, responsavel,\noficio ou descricao);
  :Persistir alteracoes;
  :Gerar alertas para gestor\n e responsavel;
fork again
  if (Demanda vinculada a cidadao\ncom opt-in?) then (sim)
    :Gerar alerta chatbot;
    :Despachar job assincrono;
    :Enviar mensagem WhatsApp\nao cidadao;
  else (nao)
    :Nao enviar notificacao\nao cidadao;
  endif
fork again
  :Publicar alerta interno\nem tempo real;
  :Exibir popup e lembretes\nno frontend;
end fork

if (Existe evento de agenda?) then (sim)
  :Criar lembretes automaticos\n(10 dias, 1 dia e 1 hora antes);
  :Despachar envio quando horario\nfor atingido;
  :Publicar lembrete via WebSocket;
else (nao)
  :Seguir fluxo normal de acompanhamento;
endif

if (Demanda concluida?) then (sim)
  :Encerrar demanda;
  :Disponibilizar dados para relatorios;
else (nao)
  :Retornar ao acompanhamento;
endif

stop
@enduml
