@startuml
skinparam linetype ortho
title Comunicação - UC07 Atualizar Evento

rectangle Usuario
rectangle Frontend
rectangle AgendaController
rectangle AgendaService
rectangle EventoRepository
rectangle AgendaReminderService

Usuario --> Frontend : 1: editarEvento()
Frontend --> AgendaController : 2: PUT /agenda/eventos/{id}
AgendaController --> AgendaService : 3: atualizarEvento(id, dados)

AgendaService --> EventoRepository : 4: buscarPorId(id)
EventoRepository --> AgendaService : 5: eventoEncontrado
AgendaService --> EventoRepository : 6: persistirAlteracoes()
EventoRepository --> AgendaService : 7: eventoAtualizado
AgendaService --> AgendaReminderService : 8: sincronizarLembretesAutomaticos()
AgendaReminderService --> AgendaService : 9: ok

AgendaService --> AgendaController : 10: sucesso()
AgendaController --> Frontend : 11: respostaOK()
Frontend --> Usuario : 12: exibirConfirmacao()
@enduml
