@startuml
skinparam linetype ortho
title Comunicação - UC05 Atualizar Emenda

rectangle Usuario
rectangle Frontend
rectangle EmendaController
rectangle EmendaService
rectangle EmendaRepository

Usuario --> Frontend : 1: editarEmenda()
Frontend --> EmendaController : 2: PUT /emendas/{id}
EmendaController --> EmendaService : 3: atualizarEmenda(id, dados)

EmendaService --> EmendaRepository : 4: buscarPorId(id)
EmendaRepository --> EmendaService : 5: emendaEncontrada
EmendaService --> EmendaRepository : 6: persistirAlteracoes()
EmendaRepository --> EmendaService : 7: emendaAtualizada

EmendaService --> EmendaController : 8: sucesso()
EmendaController --> Frontend : 9: respostaOK()
Frontend --> Usuario : 10: exibirMensagem()
@enduml
