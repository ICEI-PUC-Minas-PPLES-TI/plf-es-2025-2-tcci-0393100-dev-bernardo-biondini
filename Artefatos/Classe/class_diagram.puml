@startuml
title Diagrama de Classes - Gabinete Virtual

package "Autorização" {
  class PerfilAcesso {
    +id: int
    +nome: String
    +descricao: String
  }

  class Permissao {
    +id: int
    +codigo: String
    +descricao: String
  }

  class Usuario {
    +id: int
    +nome: String
    +email: String
    +ativo: bool
    +temPermissao(codigo: String): bool
  }
}

package "Referências" {
  class Cidade {
    +id: int
    +nome: String
    +regiao: String
  }

  class Instituicao {
    +id: int
    +nome: String
    +tipo: String
  }

  class Lideranca {
    +id: int
    +nome: String
    +cargo: String
  }
}

package "Chatbot e Cidadãos" {
  class Cidadao {
    +id: int
    +nome: String
    +cpf: String?
    +dataNascimento: Date?
    +telefoneLegado: String?
    +receberAtualizacoesDemanda: bool
  }

  class TelefoneCidadao {
    +id: int
    +telefone: String
    +telefoneNormalizado: String
  }

  class SessaoChatbot {
    +id: int
    +canal: String
    +iniciadaEm: DateTime
    +encerradaEm: DateTime?
  }

  class PreferenciaConteudo {
    +id: int
    +receberConteudo: bool
  }
}

package "Demandas" {
  class Demanda {
    +id: int
    +titulo: String
    +descricao: Text
    +areaAtendimento: AreaAtendimento?
    +status: StatusDemanda
    +mensagemDescarte: Text?
    +oficioNomeOriginal: String?
    +oficioMimeType: String?
    +prioridade: Prioridade?
    +atribuirResponsavel(usuario: Usuario)
    +atualizarStatus(status: StatusDemanda)
  }

  class HistoricoDemanda {
    +id: int
    +acao: String
    +descricao: Text
    +metadata: Json?
    +criadoEm: DateTime
  }

  class AlertaDemanda {
    +id: int
    +titulo: String
    +mensagem: Text
    +tipo: String
    +canal: CanalAlertaDemanda
    +status: StatusEnvioAlerta
    +lidoEm: DateTime?
    +enviadoEm: DateTime?
  }
}

package "Agenda" {
  class Evento {
    +id: int
    +titulo: String
    +tipo: String
    +dataEvento: DateTime
    +inicio: DateTime?
    +fim: DateTime?
    +local: String
    +contexto: Text
    +descricao: Text?
    +participantesEsperados: int?
    +cor: String?
  }

  class AlertaEvento {
    +id: int
    +titulo: String
    +mensagem: Text?
    +alertaEm: DateTime
    +antecedenciaMinutos: int?
    +canal: CanalAlertaEvento
    +status: StatusEnvioAlerta
    +automatico: bool
    +recorrente: bool
    +lidoEm: DateTime?
    +enviadoEm: DateTime?
  }
}

package "Parlamentar" {
  class Emenda {
    +id: int
    +numero: String
    +valor: Decimal
    +status: StatusEmenda
    +areaAplicacao: String
  }

  class ProjetoLei {
    +id: int
    +numero: String
    +descricao: Text
    +status: StatusProjetoLei
    +dataProtocolo: Date
  }
}

package "CMS" {
  class SecaoCms {
    +id: int
    +chave: String
    +titulo: String
    +conteudo: Text
  }

  class Noticia {
    +id: int
    +titulo: String
    +conteudo: Text
    +publicadaEm: DateTime
  }

  class ProjetoSite {
    +id: int
    +titulo: String
    +descricao: Text
    +status: StatusProjetoSite
  }
}

Usuario "1" -- "1" PerfilAcesso : possui >
PerfilAcesso "1" -- "0..*" Permissao : agrega >

Cidade "1" -- "0..*" Instituicao
Instituicao "1" -- "0..*" Lideranca
Cidade "1" -- "0..*" Emenda
Cidade "1" -- "0..*" Evento
Cidade "1" -- "0..*" ProjetoSite

Cidadao "1" -- "0..*" TelefoneCidadao
Cidadao "1" -- "0..*" SessaoChatbot
Cidadao "1" -- "0..1" PreferenciaConteudo
Cidadao "1" -- "0..*" Demanda : cria via chatbot >
Cidadao "1" -- "0..*" AlertaDemanda : recebe >

Usuario "0..1" -- "0..*" Demanda : responsável >
Usuario "0..1" -- "0..*" HistoricoDemanda : registra >
Usuario "0..1" -- "0..*" AlertaDemanda : recebe >
Usuario "0..1" -- "0..*" AlertaEvento : recebe >
Usuario "1" -- "0..*" Noticia : autor >
Usuario "1" -- "0..*" ProjetoSite : autor >

Demanda "*" -- "1" Cidade
Demanda "*" -- "0..1" Instituicao
Demanda "1" -- "0..*" HistoricoDemanda
Demanda "1" -- "0..*" AlertaDemanda
Demanda "0..*" -- "0..*" Evento

Evento "1" -- "0..*" AlertaEvento

enum StatusDemanda {
  open
  under_review
  in_progress
  completed
  discarded
}

enum Prioridade {
  low
  medium
  high
}

enum AreaAtendimento {
  saude
  educacao
  infraestrutura
  seguranca
  assistencia_social
  transporte
  habitacao
  meio_ambiente
  agricultura
  cultura
  esporte
  outro
}

enum CanalAlertaDemanda {
  system
  chatbot
}

enum CanalAlertaEvento {
  system
  email
}

enum StatusEnvioAlerta {
  pending
  queued
  sent
  failed
}

enum StatusEmenda {
  planned
  in_execution
  completed
}

enum StatusProjetoLei {
  in_committee
  in_voting
  approved
  sanctioned
}

enum StatusProjetoSite {
  planned
  in_progress
  completed
}

@enduml
